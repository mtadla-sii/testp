#!/usr/bin/env bash
# Round 3: read-only inventory of a UFT (QTP) test folder, to plan what to port to Playwright.
# Works on any folder (git not required). Reads only VBScript text (Script.mts, .qfl, .vbs);
# the binary object repositories (.bdb, .mtr, .tsr) are only counted. Prints test names, screen
# and control names, counts and call graphs, never values typed into fields.
#
# Usage (Git Bash on Windows):
#   REDACT_WORDS="client|product|rms|hdx" bash recon3-uft.sh "path/to/uft-folder" > ~/recon3.txt

set -u
ROOT="${1:-.}"
cd "$ROOT" || { echo "Cannot cd to $ROOT" >&2; exit 1; }

CORPUS=$(mktemp "${TMPDIR:-/tmp}/uft-corpus.XXXXXX")
trap 'rm -f "$CORPUS"' EXIT

# Concatenate all VBScript sources into one corpus, converting UTF-16 files to UTF-8.
while IFS= read -r -d '' f; do
  bom=$(head -c 2 "$f" | od -An -tx1 | tr -d ' \n')
  if [ "$bom" = "fffe" ]; then iconv -f UTF-16LE -t UTF-8 "$f" 2>/dev/null; else cat "$f"; fi
  echo
done < <(find . -type f \( -iname '*.mts' -o -iname '*.qfl' -o -iname '*.vbs' \) -print0) | tr -d '\r' > "$CORPUS"

section() { printf '\n## %s\n' "$1"; }
cnt() { find . -type f -iname "$1" | wc -l | tr -d ' '; }
tally() {
  local label=$1 top=$2 re=$3
  local out; out=$(grep -o -i -E -e "$re" "$CORPUS" | sed -E 's/[[:space:]]+/ /g' | sort | uniq -c | sort -rn | head -n "$top")
  echo "  $label:"
  if [ -n "$out" ]; then echo "$out" | sed 's/^/    /'; else echo "    (none)"; fi
}
occ() { printf '  %-44s %6s\n' "$1" "$(grep -o -i -E -e "$2" "$CORPUS" | wc -l | tr -d ' ')"; }

main() {
  echo "# UFT inventory (generated by recon3-uft.sh, read-only, redacted)"

  section "1. Size"
  echo "  Tests (*.tsp): $(cnt '*.tsp')"
  echo "  Actions (Script.mts): $(cnt 'Script.mts')"
  echo "  Function libraries (.qfl / .vbs): $(cnt '*.qfl') / $(cnt '*.vbs')"
  echo "  Object repositories (.tsr shared / .bdb local / .mtr): $(cnt '*.tsr') / $(cnt '*.bdb') / $(cnt '*.mtr')"
  echo "  Data tables (.xls / .xlsx): $(cnt '*.xls') / $(cnt '*.xlsx')"
  echo "  Result folders (Res*/Report): $(find . -type d \( -name 'Res[0-9]*' -o -name 'Report' \) | wc -l | tr -d ' ')"
  echo "  VBScript lines in total: $(wc -l < "$CORPUS" | tr -d ' ')"
  echo "  Newest / oldest script file date: $(find . -type f -iname '*.mts' -printf '%TY-%Tm-%Td\n' 2>/dev/null | sort | tail -1) / $(find . -type f -iname '*.mts' -printf '%TY-%Tm-%Td\n' 2>/dev/null | sort | head -1)"
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "  Last git commit in this folder: $(git log -1 --format=%cs -- .)"
  fi

  section "2. Tests (folder of each .tsp) and their actions"
  find . -type f -iname '*.tsp' -print0 | while IFS= read -r -d '' t; do
    d=$(dirname "$t")
    printf '  %3s actions | %s\n' "$(find "$d" -type f -iname 'Script.mts' | wc -l | tr -d ' ')" "${d#./}"
  done | sort -t'|' -k2 | head -n 200

  section "3. Function libraries (lines | path)"
  find . -type f \( -iname '*.qfl' -o -iname '*.vbs' \) -print0 | while IFS= read -r -d '' f; do
    printf '  %6s | %s\n' "$(wc -l < "$f" | tr -d ' ')" "${f#./}"
  done | sort -rn | head -n 40
  tally "Functions and subs defined" 80 '^[[:space:]]*(public |private )?(function|sub)[[:space:]]+[A-Za-z_][A-Za-z0-9_]*'

  section "4. Screens and controls (from scripts)"
  tally "Browsers" 15 'Browser\("[^"]+"\)'
  tally "Pages (screen inventory)" 60 'Page\("[^"]+"\)'
  tally "Control types" 30 '(WebEdit|WebButton|Link|WebList|WebTable|WebElement|WebCheckBox|WebRadioGroup|WebFile|Image|WebArea|Frame|Dialog|WinButton|WinEdit|WinObject|SwfWindow|JavaWindow|WpfWindow)\('
  tally "Edit fields" 50 'WebEdit\("[^"]+"\)'
  tally "Buttons" 50 'WebButton\("[^"]+"\)'
  tally "Lists" 30 'WebList\("[^"]+"\)'
  tally "Tables" 20 'WebTable\("[^"]+"\)'
  tally "Windows dialogs (file upload/download, alerts)" 20 '(Dialog|Window)\("[^"]+"\)'
  occ "Descriptive programming (micclass:= / html id:=)" '(micclass|html id|xpath|innertext|name):='

  section "5. Methods, waits and checks"
  tally "Methods" 30 '\.(Set|SetSecure|Click|Select|Type|Exist|Sync|WaitProperty|GetROProperty|SetTOProperty|CheckProperty|Check|Output|FireEvent|DoubleClick|Submit|Navigate|Close|RefreshObject|ChildObjects|GetCellData|RowCount)\b'
  tally "Fixed waits" 15 '(^|[^A-Za-z.])Wait[[:space:]]*\(?[[:space:]]*[0-9]+'
  occ "Reporter.ReportEvent" 'Reporter\.ReportEvent'
  tally "Report statuses" 5 'mic(Pass|Fail|Warning|Done)'
  occ "Checkpoints (.Check CheckPoint)" 'Check[[:space:]]*\(?[[:space:]]*CheckPoint\('
  occ "Recovery / On Error Resume Next" 'On Error Resume Next|Recovery\.'

  section "6. Data and flow"
  tally "DataTable usage" 15 'DataTable(\.[A-Za-z]+)?(\("[^"]+")?'
  tally "RunAction calls (reuse graph)" 40 'RunAction[[:space:]]+"[^"]+"'
  tally "Library loading" 10 '(LoadFunctionLibrary|ExecuteFile|LoadAndRunAction)[[:space:]]*\(?[[:space:]]*"[^"]*"'
  tally "Environment variables" 30 'Environment(\.Value)?\("[^"]+"\)'
  tally "External systems touched" 20 'CreateObject\("[^"]+"\)'
  occ "Database access (ADODB)" 'ADODB\.'
  occ "SetSecure (encrypted passwords, values not printed)" '\.SetSecure'
}

main 2>&1 | perl -pe '
  BEGIN {
    my @w = map { quotemeta } grep { length } split /\|/, ($ENV{REDACT_WORDS} // "");
    $re = @w ? "(?<![A-Za-z])(?:" . join("|", @w) . ")" : undef;
  }
  s#\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b#<email>#g;
  s#\b(https?|wss?)://[^/\s"\x27\x60)<>]+#$1://<host>#gi;
  s#\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b#<guid>#g;
  s#\b(?:\d{1,3}\.){3}\d{1,3}\b#<ip>#g;
  s#\\\\[A-Za-z0-9._-]+\\#\\\\<server>\\#g;
  s/$re/<X>/gi if defined $re;
'
