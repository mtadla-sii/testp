#!/usr/bin/env bash
# Round 2 of the read-only reconnaissance: AngularJS front end, the BDD module, auth details,
# readiness signals, background jobs and module activity. Same rules as round 1: counts, versions
# and short matched fragments only, everything passed through the redaction filter.
#
# Usage (Git Bash on Windows), from the folder that holds this script and the repository:
#   REDACT_WORDS="client|product|rms|hdx" bash recon2.sh XXX > ~/recon2.txt
# REDACT_WORDS match only at the start of a word, so "rms" masks "rms-web" but not "forms".

set -u
REPO="${1:-.}"
cd "$REPO" || { echo "Cannot cd to $REPO" >&2; exit 1; }
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "Not a git repository: $REPO" >&2; exit 1; }

NOVENDOR=(':!*bower_components/*' ':!*node_modules/*' ':!*.min.js' ':!*/vendor/*')
JS=('*.js' "${NOVENDOR[@]}")
HTML=('*.html' "${NOVENDOR[@]}")
WEB=('*.js' '*.html' "${NOVENDOR[@]}")
JAVA=('*.java' '*.kt')
CFG=('*.properties' '*.yml' '*.yaml' "${NOVENDOR[@]}" ':!Build/*')

gg() { git grep -I "$@" 2>/dev/null | tr -d '\r'; }
n() { wc -l | tr -d ' '; }
section() { printf '\n## %s\n' "$1"; }

occ() {
  local ci=""; [ "$1" = "-i" ] && { ci="-i"; shift; }
  local label=$1 re=$2; shift 2
  printf '  %-48s %6s hits in %5s files\n' "$label" \
    "$(gg $ci -h -o -E -e "$re" -- "$@" | n)" \
    "$(gg $ci -l -E -e "$re" -- "$@" | n)"
}

tally() {
  local ci=""; [ "$1" = "-i" ] && { ci="-i"; shift; }
  local label=$1 top=$2 re=$3; shift 3
  local out; out=$(gg $ci -h -o -E -e "$re" -- "$@" | sed -E 's/[[:space:]]+/ /g' | sort | uniq -c | sort -rn | head -n "$top")
  echo "  $label:"
  if [ -n "$out" ]; then echo "$out" | sed 's/^/    /'; else echo "    (none)"; fi
}

files() {
  local label=$1 max=$2; shift 2
  local all; all=$(git ls-files -- "$@")
  echo "  $label (total $(printf '%s' "$all" | grep -c .)):"
  [ -n "$all" ] && echo "$all" | head -n "$max" | sed 's/^/    /'
}

# examples LABEL MAX REGEX PATHSPEC... -> a few matched fragments, to see the shape
examples() {
  local label=$1 max=$2 re=$3; shift 3
  echo "  $label:"
  local out; out=$(gg -h -o -E -e "$re" -- "$@" | sed -E 's/^[[:space:]]+//' | sort -u | head -n "$max")
  if [ -n "$out" ]; then echo "$out" | sed 's/^/    /'; else echo "    (none)"; fi
}

main() {
  echo "# Repository reconnaissance, round 2 (generated by recon2.sh, read-only, redacted)"

  section "A. Module activity (2nd-level folders with more than 20 files)"
  echo "  files | last commit | commits in 90 days | folder"
  git ls-files | cut -d/ -f1-2 | sort | uniq -c | awk '$1>20 { c=$1; $1=""; sub(/^ /, ""); print c "\t" $0 }' |
    while IFS="$(printf '\t')" read -r c d; do
      printf '  %5s | %s | %4s | %s\n' "$c" "$(git log -1 --format=%cs -- "$d")" \
        "$(git rev-list --count --since=90.days HEAD -- "$d")" "$d"
    done

  section "B. JavaScript libraries and versions (vendored files included)"
  tally "License banners" 40 '@license (AngularJS|Angular[A-Za-z. -]*) v[0-9][0-9.a-z-]*|jQuery (JavaScript Library )?v[0-9][0-9.]+|Bootstrap v[0-9][0-9.]+|RequireJS [0-9][0-9.]+|Highcharts JS v[0-9][0-9.]+|ui-grid - v[0-9][0-9.]+|lodash [0-9][0-9.]+|moment(\.js)? ?(version)? ?:? ?[0-9]+\.[0-9]+\.[0-9]+' '*.js'
  tally "bower.json dependencies" 60 '"[A-Za-z0-9@/._-]+" *: *"[~^<>=]*[0-9][^"]*"' '*bower.json' ':!*bower_components/*'
  files "AngularJS and plugin files" 30 '*angular*.js' '*ui-router*.js' '*ui-bootstrap*.js' '*ui-grid*.js' '*ng-file-upload*.js'
  files "bower.json files outside bower_components" 10 '*bower.json' ':!*bower_components/*'

  section "C. AngularJS usage in application code (vendor excluded)"
  occ "angular.module(" 'angular\.module\(' "${JS[@]}"
  tally "Registered pieces" 10 '\.(controller|directive|component|service|factory|filter|provider|config|run)\(' "${JS[@]}"
  tally "Routing" 10 '\$routeProvider|\$stateProvider|\$urlRouterProvider|ng-view|ui-view|\$location' "${WEB[@]}"
  tally "AngularJS services" 20 '\$(http|resource|timeout|interval|q|rootScope|scope\.\$apply|scope\.\$watch|uibModal|mdDialog|window|document|compile|sce)' "${JS[@]}"
  tally "ng- attributes in templates" 40 'ng-[a-z-]+=' "${HTML[@]}"
  occ "ng-app / ng-controller pages" 'ng-(app|controller)=' "${HTML[@]}"
  tally "UI libraries (tags and attributes)" 25 'ui-grid[a-z-]*|uib-[a-z-]+|st-table|md-[a-z-]+|ng-table|datatable|data-toggle="[a-z]+"' "${HTML[@]}"
  occ "Inline templates in JS (template:)" 'template(Url)? *:' "${JS[@]}"

  section "D. Server-side templates (Thymeleaf)"
  files "Thymeleaf templates" 5 '*templates/*.html' "${NOVENDOR[@]}"
  occ "th: attributes" 'th:[a-z]+=' "${HTML[@]}"
  occ "th:fragment / th:replace / th:insert" 'th:(fragment|replace|insert)=' "${HTML[@]}"
  tally "sec:authorize (role-based UI)" 25 'sec:authorize="[^"]*"' "${HTML[@]}"
  echo "  Locator material in non-vendor HTML:"
  occ "    id=\"...\" (static)" ' id="[A-Za-z]' "${HTML[@]}"
  occ "    name=\"...\"" ' name="[A-Za-z]' "${HTML[@]}"
  occ "    data-* attributes" ' data-[a-z-]+=' "${HTML[@]}"
  tally "    data-* attribute names" 20 ' data-[a-z-]+=' "${HTML[@]}"
  occ "    test ids (data-testid/test/cy/qa/e2e)" 'data-(testid|test-id|test|cy|qa|e2e)=' "${HTML[@]}" "${JS[@]}"

  section "E. Readiness and AJAX"
  examples "isBusy / showSpinner / isLoading usage (shape)" 12 '.{0,30}(isBusy|showSpinner|isLoading).{0,50}' "${WEB[@]}"
  tally "Global AJAX hooks" 20 '\$\(document\)\.ajax(Start|Stop|Send|Complete|Error|Success)|\$\.ajaxSetup|ajaxStart|ajaxStop|\$httpProvider\.interceptors|pendingRequests|\$http\.pendingRequests|notifyWhenNoOutstandingRequests' "${JS[@]}"
  tally "AJAX call styles" 15 '\$\.(ajax|get|post|getJSON)\(|\$http\.(get|post|put|delete)\(|\$http\(|fetch\(|new XMLHttpRequest' "${JS[@]}"
  examples "EventSource and WebSocket targets (shape)" 10 'new (EventSource|WebSocket)\([^)]{0,60}\)' "${JS[@]}"
  tally "Native dialogs in app code" 10 '(window\.)?(alert|confirm|prompt)\(' "${JS[@]}"
  tally "Modal libraries" 10 '\$uibModal|\.modal\(|bootbox|sweetalert|swal\(|toastr' "${JS[@]}"

  section "F. Auth details"
  tally "CSRF" 20 'csrf\([^)]*\)|csrf\(\)\.disable|CookieCsrfTokenRepository|ignoringRequestMatchers|_csrf|X-CSRF-TOKEN|X-XSRF-TOKEN|XSRF-TOKEN' "${JAVA[@]}" "${WEB[@]}"
  tally -i "Identity provider hints" 20 'azure|entra|microsoftonline|okta|keycloak|pingfederate|pingone|auth0|cognito|onelogin|forgerock|adfs' "${JAVA[@]}" "${CFG[@]}"
  tally "OAuth2 client config" 20 'ClientRegistration[A-Za-z]*|registrationId|OidcUser[A-Za-z]*|OAuth2User[A-Za-z]*|issuer-uri|jwk-set-uri|user-name-attribute|GrantedAuthoritiesMapper|JwtAuthenticationConverter|JwtGrantedAuthoritiesConverter' "${JAVA[@]}" "${CFG[@]}"
  tally "Session and logout" 15 'SessionCreationPolicy\.[A-Z_]+|maximumSessions\([0-9]+\)|invalidSessionUrl|sessionFixation|rememberMe|logoutSuccessUrl|logoutUrl|deleteCookies\([^)]*\)' "${JAVA[@]}"
  tally "Where authorities come from" 15 'getAuthorities\(\)|SimpleGrantedAuthority|"roles"|"groups"|"scp"|"wids"|appRoles|getClaim[A-Za-z]*\("[a-z_]+"\)' "${JAVA[@]}"
  tally "Login / access-denied pages" 10 'loginPage\([^)]*\)|accessDeniedPage\([^)]*\)|defaultSuccessUrl\([^)]*\)|failureUrl\([^)]*\)' "${JAVA[@]}"

  section "G. Background jobs, actuator, config"
  tally "Quartz" 15 'implements Job|extends QuartzJobBean|@DisallowConcurrentExecution|CronScheduleBuilder|cronSchedule\(|SimpleScheduleBuilder|withIntervalIn[A-Za-z]+\( *[0-9]+|JobBuilder\.newJob' "${JAVA[@]}"
  tally "Actuator and management" 15 'management\.[a-z.-]+|/actuator[a-z/]*|@Endpoint\(|HealthIndicator' "${JAVA[@]}" "${CFG[@]}" "${WEB[@]}"
  files "Config files outside vendor and Build (names only)" 25 "${CFG[@]}"
  tally "Spring profiles referenced" 15 '@Profile\("[^"]+"\)|spring\.profiles\.active[=:]? *[A-Za-z,-]+' "${JAVA[@]}" "${CFG[@]}" '*.yml'
  tally "Environment variables read" 25 'System\.getenv\("[A-Z_]+"\)|\$\{[A-Z][A-Z0-9_]+(:[^}]*)?\}' "${JAVA[@]}" "${CFG[@]}" '*.yml' '*.ps1'

  section "H. BDD module"
  files "BDD files" 5 '*BDD/*'
  tally "BDD pom artifactIds" 50 '<artifactId>[^<]+' '*BDD/pom.xml'
  echo "  Feature files: $(git ls-files -- '*.feature' | n)"
  occ "  Scenario" '^ *Scenario:' '*.feature'
  occ "  Scenario Outline" '^ *Scenario (Outline|Template):' '*.feature'
  occ "  Background" '^ *Background:' '*.feature'
  tally "  Tags" 30 '@[A-Za-z0-9_.-]+' '*.feature'
  echo "  Feature file languages: $(gg -h -o -E -e '^# *language: *[a-z-]+' -- '*.feature' | sort | uniq -c | tr '\n' ' ')"
  occ "Step definitions (@Given/@When/@Then)" '@(Given|When|Then|And|But)\(' "${JAVA[@]}"
  tally "Runner and config" 15 '@CucumberOptions|@RunWith\([A-Za-z.]+|@Suite|@IncludeEngines\([^)]*\)|@ConfigurationParameter|@SelectClasspathResource|cucumber\.[a-z.]+' "${JAVA[@]}" '*.properties' '*BDD/pom.xml'
  tally "UI driver style" 20 'WebDriver|ChromeDriver|EdgeDriver|RemoteWebDriver|WebDriverWait|By\.(id|xpath|cssSelector|name|className|linkText|partialLinkText|tagName)|@FindBy|PageFactory|Selenide|\$\(By' "${JAVA[@]}"
  tally "API driver style" 15 'RestAssured|given\(\)|RequestSpecification|HttpClient|WebClient|RestTemplate|TestRestTemplate' '*BDD/*.java'
  tally "Waits and sleeps in BDD" 15 'Thread\.sleep\([^)]*\)|implicitlyWait|ExpectedConditions\.[a-zA-Z]+|Awaitility|pollInterval' '*BDD/*.java'
  echo "  BDD mentioned in pipelines: $(gg -l -i -E -e 'BDD|cucumber' -- 'Build/*' '*.yml' | n) files"
  echo "  Last commit touching .feature files: $(git log -1 --format=%cs -- '*.feature')"

  section "I. Protractor (old E2E)"
  files "e2e-tests files" 15 '*e2e-tests/*'
  echo "  Last commit in e2e-tests: $(git log -1 --format=%cs -- '*e2e-tests/*')"
  tally "Protractor locators" 15 'by\.(model|binding|repeater|css|id|xpath|buttonText|linkText|cssContainingText)|element\(|browser\.(get|wait|sleep|waitForAngular)' '*e2e-tests/*'
}

redact() {
  perl -pe '
    BEGIN {
      my @w = map { quotemeta } grep { length } split /\|/, ($ENV{REDACT_WORDS} // "");
      $re = @w ? "(?<![A-Za-z])(?:" . join("|", @w) . ")" : undef;
    }
    s#\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b#<email>#g;
    s#\b(https?|wss?)://[^/\s"\x27\x60)<>]+#$1://<host>#gi;
    s#\bdev\.azure\.com/[^/\s"\x27]+#dev.azure.com/<org>#gi;
    s#\b[A-Za-z0-9-]+\.(azurewebsites\.net|azurecr\.io|blob\.core\.windows\.net|vault\.azure\.net|database\.windows\.net|servicebus\.windows\.net|azure-api\.net|azurefd\.net|onmicrosoft\.com|visualstudio\.com|ghe\.com)\b#<host>.$1#gi;
    s#\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b#<guid>#g;
    s#\b(?:\d{1,3}\.){3}\d{1,3}\b#<ip>#g;
    s/$re/<X>/gi if defined $re;
  '
}

main 2>&1 | redact
